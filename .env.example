# Copy to dv_agent/.env (git-ignored). Real environment variables take precedence.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# responses (default) or chat
META_API_STYLE=responses
META_MAX_OUTPUT_TOKENS=8192
# Token-limit responses retry at most twice, doubling up to this ceiling.
META_MAX_OUTPUT_TOKENS_CEILING=32768
# Embeddings model for dense retrieval (optional)
META_EMBED_MODEL=
# auto | on | off
DV_AGENT_LLM_MODE=auto
# Repair attempts after a check refuses model output (0 disables)
DV_AGENT_MAX_REPAIRS=2

# Langfuse Cloud or self-hosted; leave empty to trace to the local runs/<repo>/trace.jsonl only
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# E2E MyAccount (e2e-sim): token + project from MyAccount > API & IAM.
# Never commit real values; copy this file to dv_agent/.env (git-ignored).
E2E_AUTH_TOKEN=
E2E_API_KEY=
E2E_PROJECT_ID=
E2E_LOCATION=Chennai
E2E_REGION=chennai
E2E_PLAN=
E2E_IMAGE=
E2E_NODE_NAME=xezim-sim
E2E_SIM_SSH_KEY=~/.ssh/id_ed25519
# E2E Ubuntu images inject keys for root (verified live).
E2E_SIM_SSH_USER=root
