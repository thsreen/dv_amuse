# Copy to dv_agent/.env (git-ignored). Real environment variables take precedence.
MODEL_API_KEY=
# Optional knowledge-graph analysis instead of the default basic retrieval: DV_AGENT_MODE=graph
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# responses (default) or chat
META_API_STYLE=responses
# Per model API request (including basic mode); explicit caller timeout overrides.
META_REQUEST_TIMEOUT_SECONDS=150
# Baseline output allowance for a 2,000-byte input payload; scales with input size.
META_MAX_OUTPUT_TOKENS=8192
# Up to five attempts; every retry grows the previous allowance 25%, capped here.
META_MAX_OUTPUT_TOKENS_CEILING=32768
# Embeddings model for dense retrieval (optional)
META_EMBED_MODEL=
# auto | on | off
DV_AGENT_LLM_MODE=auto
# Repair attempts after a check refuses model output (0 disables)
DV_AGENT_MAX_REPAIRS=2
# Parallel extraction calls during build-graph, 1-4 (default 1; --workers overrides)
DV_AGENT_MAX_WORKERS=1

# Langfuse Cloud or self-hosted; leave empty to trace to the local runs/<repo>/trace.jsonl only
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Prompts, specification text and model output stay local unless you set this to 1 (they may be confidential).
LANGFUSE_CAPTURE_CONTENT=

# E2E MyAccount (e2e-sim): token + project from MyAccount > API & IAM.
# Never commit real values; copy this file to dv_agent/.env (git-ignored).
E2E_AUTH_TOKEN=
E2E_API_KEY=
E2E_PROJECT_ID=
E2E_LOCATION=Chennai
E2E_REGION=chennai
E2E_PLAN=
E2E_IMAGE=
E2E_NODE_NAME=xezim-sim
E2E_SIM_SSH_KEY=~/.ssh/id_ed25519
# E2E Ubuntu images inject keys for root (verified live).
E2E_SIM_SSH_USER=root
# Local xezim binary uploaded to new nodes (skips the node-side build).
E2E_SIM_XEZIM_BIN=.e2e-bin/xezim
# Official UVM source release; populated by: python3 tools/install_uvm.py
XEZIM_UVM_DIR=.deps/uvm-core-2020.3.1/src
