{
  "description": "Basic functional demo for a 16550-style UART top: named register writes, one transmit packet and one receive packet, checked by scoreboard routes. Design-specific DATA, not generator logic. Ports are RTL names; every fact_ids is filled by the builder with one cited documented plan item. Not verification sign-off. Address 0 and 1 are shared (transmit data / divisor low, interrupt enable / divisor high), so each address is declared once.",
  "top": "uart_top",
  "defines": [
    "DATA_BUS_WIDTH_8"
  ],
  "agents": [
    {
      "id": "register_bus",
      "protocol": "wishbone",
      "bindings": {
        "addr": "wb_adr_i",
        "wdata": "wb_dat_i",
        "rdata": "wb_dat_o",
        "we": "wb_we_i",
        "stb": "wb_stb_i",
        "cyc": "wb_cyc_i",
        "ack": "wb_ack_o"
      }
    },
    {
      "id": "serial_link",
      "protocol": "serial",
      "bindings": {
        "rx": "srx_pad_i",
        "tx": "stx_pad_o"
      },
      "bit_cycles": 32,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "idle_values": {
        "srx_pad_i": 1
      }
    }
  ],
  "registers": [
    {
      "id": "line_control",
      "agent": "register_bus",
      "address": 3,
      "width": 8,
      "access": "RW",
      "reset": 3,
      "mask": 255
    },
    {
      "id": "data_or_divisor_low",
      "agent": "register_bus",
      "address": 0,
      "width": 8,
      "access": "WO",
      "mask": 255
    },
    {
      "id": "interrupt_enable_or_divisor_high",
      "agent": "register_bus",
      "address": 1,
      "width": 8,
      "access": "WO",
      "mask": 255
    },
    {
      "id": "fifo_control",
      "agent": "register_bus",
      "address": 2,
      "width": 8,
      "access": "WO",
      "mask": 255
    }
  ],
  "sequences": [
    {
      "id": "configure_link",
      "agent": "register_bus",
      "purpose": "Set the divisor and 8N1 framing with named register writes",
      "operations": [
        {
          "kind": "register_write",
          "register_id": "line_control",
          "data": 131
        },
        {
          "kind": "register_write",
          "register_id": "interrupt_enable_or_divisor_high",
          "data": 0
        },
        {
          "kind": "register_write",
          "register_id": "data_or_divisor_low",
          "data": 2
        },
        {
          "kind": "register_write",
          "register_id": "line_control",
          "data": 3
        },
        {
          "kind": "register_write",
          "register_id": "interrupt_enable_or_divisor_high",
          "data": 0
        },
        {
          "kind": "register_write",
          "register_id": "fifo_control",
          "data": 6
        }
      ]
    },
    {
      "id": "read_back_line_control",
      "agent": "register_bus",
      "purpose": "Read the written line control back",
      "operations": [
        {
          "kind": "read",
          "address": 3
        }
      ]
    },
    {
      "id": "send_one_packet",
      "agent": "register_bus",
      "purpose": "Transmit one byte",
      "operations": [
        {
          "kind": "register_write",
          "register_id": "data_or_divisor_low",
          "data": 165
        }
      ]
    },
    {
      "id": "receive_one_packet",
      "agent": "serial_link",
      "purpose": "Drive one byte into the receiver",
      "operations": [
        {
          "kind": "send",
          "data": 90
        }
      ]
    },
    {
      "id": "collect_received_packet",
      "agent": "register_bus",
      "purpose": "Wait for data ready, then read the byte",
      "operations": [
        {
          "kind": "poll",
          "address": 5,
          "data": 1,
          "mask": 1
        },
        {
          "kind": "read",
          "address": 0
        }
      ]
    }
  ],
  "routes": [
    {
      "id": "transmit_path",
      "expected_agent": "register_bus",
      "expected_event": "write",
      "expected_address": 0,
      "actual_agent": "serial_link",
      "actual_event": "tx",
      "mask": 255,
      "when": [
        {
          "agent": "register_bus",
          "address": 3,
          "mask": 128,
          "value": 0,
          "initial_value": 3
        }
      ]
    },
    {
      "id": "receive_path",
      "expected_agent": "serial_link",
      "expected_event": "rx",
      "actual_agent": "register_bus",
      "actual_event": "read",
      "actual_address": 0,
      "mask": 255
    }
  ],
  "checks": [
    {
      "id": "bus_known",
      "agent": "register_bus",
      "kind": "known_controls"
    }
  ],
  "tests": [
    {
      "id": "basic_demo",
      "drain_cycles": 2048,
      "minimum_comparisons": 3,
      "stages": [
        [
          "configure_link"
        ],
        [
          "read_back_line_control"
        ],
        [
          "send_one_packet"
        ],
        [
          "receive_one_packet"
        ],
        [
          "collect_received_packet"
        ]
      ]
    }
  ]
}
