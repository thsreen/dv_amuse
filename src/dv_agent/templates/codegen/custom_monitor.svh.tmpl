class {{AGENT}}_monitor extends uvm_component;
  `uvm_component_utils({{AGENT}}_monitor)
  {{AGENT}}_cfg cfg;
  uvm_analysis_port #(cg_item) ap;
{{MONITOR_SIGNAL_DECLARATIONS}}
  function new(string name, uvm_component parent); super.new(name,parent); ap=new("ap",this); endfunction
  virtual function void reset_values();
{{MONITOR_RESET_ASSIGNMENTS}}
  endfunction
  virtual function void sample_signals();
{{MONITOR_SIGNAL_ASSIGNMENTS}}
  endfunction
  virtual task monitor_interface();
{{MONITOR_HOOK}}
  endtask
  task run_phase(uvm_phase phase);
    reset_values();
    fork
      forever begin
        @(posedge cfg.vif.clk);
        if (cfg.vif.reset == cfg.reset_active) reset_values();
        else sample_signals();
      end
      monitor_interface();
    join
  endtask
endclass
