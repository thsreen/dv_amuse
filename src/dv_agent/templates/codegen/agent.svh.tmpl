class {{AGENT}}_agent extends uvm_agent;
  `uvm_component_utils({{AGENT}}_agent)
  {{AGENT}}_cfg cfg;
  {{AGENT}}_sequencer sqr;
  {{AGENT}}_driver drv;
  {{AGENT}}_monitor mon;
  {{AGENT}}_coverage cov;
  function new(string name, uvm_component parent); super.new(name, parent); endfunction
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    mon = {{AGENT}}_monitor::type_id::create("mon", this); mon.cfg = cfg;
    cov = {{AGENT}}_coverage::type_id::create("cov", this); cov.cfg = cfg;
    if (cfg.active) begin
      sqr = {{AGENT}}_sequencer::type_id::create("sqr", this); sqr.cfg = cfg;
      drv = {{AGENT}}_driver::type_id::create("drv", this); drv.cfg = cfg;
    end
  endfunction
  function void connect_phase(uvm_phase phase);
    if (cfg.active) drv.seq_item_port.connect(sqr.seq_item_export);
    mon.ap.connect(cov.analysis_export);
  endfunction
endclass
