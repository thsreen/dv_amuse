  class {{UVC_NAME}}_base_seq extends uvm_sequence #({{UVC_NAME}}_item);
    `uvm_object_utils({{UVC_NAME}}_base_seq)
    `uvm_declare_p_sequencer({{UVC_NAME}}_sequencer)
{{CUSTOM_BASE_SEQ_DECLARATIONS}}
    function new(string name="{{UVC_NAME}}_base_seq"); super.new(name); endfunction
    virtual function void configure_item({{UVC_NAME}}_item tr);
      if (!tr.randomize()) `uvm_fatal("RAND", "transaction randomization failed")
{{CUSTOM_BASE_SEQ_CONFIGURE}}
    endfunction
    virtual task apply_configuration();
{{CUSTOM_BASE_SEQ_SETUP}}
    endtask
    virtual function int unsigned item_count(); return p_sequencer.cfg.num_items; endfunction
    task body();
