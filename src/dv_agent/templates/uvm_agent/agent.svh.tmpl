  class {{UVC_NAME}}_agent extends uvm_agent;
    `uvm_component_utils({{UVC_NAME}}_agent)
    {{UVC_NAME}}_cfg cfg;
    {{UVC_NAME}}_sequencer sqr;
    {{UVC_NAME}}_driver drv;
    {{UVC_NAME}}_monitor mon;
    {{UVC_NAME}}_scoreboard sb;
{{CUSTOM_AGENT_DECLARATIONS}}
    function new(string name, uvm_component parent); super.new(name, parent); endfunction
    function void build_phase(uvm_phase phase);
      super.build_phase(phase);
      if (!uvm_config_db #({{UVC_NAME}}_cfg)::get(this, "", "cfg", cfg))
        `uvm_fatal("CFG", "agent config missing")
      if (cfg.vif == null) `uvm_fatal("VIF", "virtual interface missing")
      mon = {{UVC_NAME}}_monitor::type_id::create("mon", this); mon.cfg = cfg;
      if (cfg.is_active == UVM_ACTIVE) begin
        sqr = {{UVC_NAME}}_sequencer::type_id::create("sqr", this); sqr.cfg = cfg;
        drv = {{UVC_NAME}}_driver::type_id::create("drv", this); drv.cfg = cfg;
      end
      if (cfg.enable_scoreboard) begin
        sb = {{UVC_NAME}}_scoreboard::type_id::create("sb", this);
      end
{{CUSTOM_AGENT_BUILD}}
    endfunction
    function void connect_phase(uvm_phase phase);
      if (cfg.is_active == UVM_ACTIVE) drv.seq_item_port.connect(sqr.seq_item_export);
      if (sb != null) mon.ap.connect(sb.analysis_export);
{{CUSTOM_AGENT_CONNECT}}
    endfunction
  endclass
