        `uvm_fatal("VIF", "set vif in uvm_config_db before run_test")
      uvm_config_db #({{UVC_NAME}}_cfg)::set(this, "env.agent", "cfg", cfg);
      env = {{UVC_NAME}}_env::type_id::create("env", this);
{{CUSTOM_TEST_BUILD}}
    endfunction
    task run_phase(uvm_phase phase);
      {{UVC_NAME}}_base_seq seq;
{{RESET_TEST_RUN_DECLARATIONS}}
      phase.raise_objection(this);
{{RESET_TEST_RUN}}
      if (cfg.is_active == UVM_ACTIVE) begin
        if (cfg.enable_base_sequence) begin
          seq = {{UVC_NAME}}_base_seq::type_id::create("base_seq");
          seq.start(env.agent.sqr);
        end
{{NAMED_SEQUENCE_STARTS}}
      end
{{CUSTOM_TEST_RUN}}
      phase.drop_objection(this);
