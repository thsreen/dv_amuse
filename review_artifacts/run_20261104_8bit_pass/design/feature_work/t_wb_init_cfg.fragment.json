  "facts": [
    {
      "id": "f_init_dlab1",
      "statement": "LCR bit7 set to 1 allows access to Divisor Latches",
      "source_id": "CH-1e2324cfc3",
      "quote": "Set bit 7 to \u20181\u2019",
      "plan_pointer": "/sections/10/entries/5"
    },
    {
      "id": "f_init_dlab0",
      "statement": "LCR bit7 cleared to 0 disables Divisor Latch access and returns to normal registers",
      "source_id": "CH-1e2324cfc3",
      "quote": "Set bit 7 of LCR to \u20180\u2019 to disable access to Divisor Latches.",
      "plan_pointer": "/sections/10/entries/5"
    },
    {
      "id": "f_init_divorder",
      "statement": "Divisor programming order is MSB first then LSB next",
      "source_id": "CH-1e2324cfc3",
      "quote": "Set the Divisor Latches, MSB first, LSB next.",
      "plan_pointer": "/sections/10/entries/5"
    },
    {
      "id": "f_init_divreset",
      "statement": "Post-reset Divisor Latch value is 0",
      "source_id": "CH-1e2324cfc3",
      "quote": "The Divisor Latch register is set to 0.",
      "plan_pointer": "/sections/10/entries/5"
    },
    {
      "id": "f_init_fifotrig",
      "statement": "Initialization requires setting FIFO trigger level after DLAB cleared",
      "source_id": "CH-1e2324cfc3",
      "quote": "Set the FIFO trigger level.",
      "plan_pointer": "/sections/10/entries/5"
    },
    {
      "id": "f_init_ier",
      "statement": "Initialization requires enabling desired interrupts via Interrupt Enable Register",
      "source_id": "CH-1e2324cfc3",
      "quote": "Enable desired interrupts by setting appropriate bits in the Interrupt Enable",
      "plan_pointer": "/sections/10/entries/5"
    },
    {
      "id": "f_init_lcrfmt",
      "statement": "Post-reset LCR is 8 bits data no parity 1 stop bit",
      "source_id": "CH-1e2324cfc3",
      "quote": "The Line Control Register is set to communication of 8 bits of data, no parity, 1",
      "plan_pointer": "/sections/10/entries/5"
    },
    {
      "id": "f_dlab_gate",
      "statement": "When DLAB is 1 normal registers at addresses 0-1 cannot be accessed",
      "source_id": "CH-f88915355b",
      "quote": "At this time the above registers at addresses 0-1 can\u2019t be accessed.",
      "plan_pointer": "/sections/9/entries/1"
    },
    {
      "id": "f_addr_lcr",
      "statement": "LCR is at bus address 3 width 8 access RW",
      "source_id": "CH-f88915355b",
      "quote": "Line Control Register 3 8 RW Control connection",
      "plan_pointer": "/sections/9/entries/1"
    },
    {
      "id": "f_addr_divlsb",
      "statement": "Divisor LSB is at bus address 0 width 8 access RW",
      "source_id": "CH-f88915355b",
      "quote": "Divisor Latch Byte 1 (LSB) 0 8 RW The LSB of the divisor",
      "plan_pointer": "/sections/9/entries/1"
    },
    {
      "id": "f_addr_divmsb",
      "statement": "Divisor MSB is at bus address 1 width 8 access RW",
      "source_id": "CH-f88915355b",
      "quote": "Divisor Latch Byte 2 1 8 RW The MSB of the divisor",
      "plan_pointer": "/sections/9/entries/1"
    },
    {
      "id": "f_addr_ier",
      "statement": "IER is at bus address 1 width 8 access RW when DLAB is 0",
      "source_id": "CH-f88915355b",
      "quote": "Interrupt Enable 1 8 RW Enable/Mask interrupts",
      "plan_pointer": "/sections/9/entries/1"
    },
    {
      "id": "f_addr_fcr",
      "statement": "FCR is at bus address 2 width 8 access W",
      "source_id": "CH-f88915355b",
      "quote": "FIFO Control 2 8 W Control FIFO options",
      "plan_pointer": "/sections/9/entries/1"
    },
    {
      "id": "f_fcr_trigdef",
      "statement": "FCR bits 7-6 define Receiver FIFO interrupt trigger level",
      "source_id": "CH-dfb1048908",
      "quote": "Define the Receiver FIFO Interrupt trigger level",
      "plan_pointer": "/sections/12/entries/1"
    },
    {
      "id": "f_fcr_trig14",
      "statement": "FCR trigger encoding 11 selects 14 bytes",
      "source_id": "CH-dfb1048908",
      "quote": "\u201811\u2019 \u2013 14 bytes",
      "plan_pointer": "/sections/12/entries/1"
    },
    {
      "id": "f_fcr_clear",
      "statement": "FCR bit1 write 1 clears Receiver FIFO so init drives it 0 unless clearing",
      "source_id": "CH-dfb1048908",
      "quote": "Writing a \u20181\u2019 to bit 1 clears the Receiver FIFO",
      "plan_pointer": "/sections/12/entries/1"
    },
    {
      "id": "f_ier_bit0",
      "statement": "IER bit0 is Received Data available interrupt RW",
      "source_id": "CH-de51b2eafc",
      "quote": "0 RW Received Data available interrupt",
      "plan_pointer": "/sections/8/entries/2"
    },
    {
      "id": "f_ier_en",
      "statement": "IER enable value 1 means enabled",
      "source_id": "CH-de51b2eafc",
      "quote": "\u20181\u2019 \u2013 enabled",
      "plan_pointer": "/sections/8/entries/2"
    },
    {
      "id": "f_ier_dis",
      "statement": "IER enable value 0 means disabled",
      "source_id": "CH-de51b2eafc",
      "quote": "\u20180\u2019 \u2013 disabled",
      "plan_pointer": "/sections/8/entries/2"
    },
    {
      "id": "f_ier_reserved",
      "statement": "IER bits 7-4 reserved should be 0",
      "source_id": "CH-de51b2eafc",
      "quote": "7-4 RW Reserved. Should be logic \u20180\u2019.",
      "plan_pointer": "/sections/8/entries/2"
    }
  ],
