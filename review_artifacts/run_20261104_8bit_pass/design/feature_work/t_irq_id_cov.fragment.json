      "id": "t_irq_id_cov_f_pending",
      "statement": "IIR bit0 0 means interrupt pending, 1 means no interrupt pending.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Bit 0 indicates that an interrupt is pending when it\u2019s logic \u20180\u2019. When it\u2019s \u20181\u2019 \u2013 no interrupt\nis pending.",
      "plan_pointer": "/registers/registers/6/fields/0"
    },
    {
      "id": "t_irq_id_cov_f_highest",
      "statement": "IIR reports current highest priority pending interrupt.",
      "source_id": "CH-f91cbf1c05",
      "quote": "The IIR enables the programmer to retrieve what is the current highest priority pending\ninterrupt.",
      "plan_pointer": "/sections/8/entries/4"
    },
    {
      "id": "t_irq_id_cov_f_rls",
      "statement": "IIR 011 is 1st priority Receiver Line Status from parity overrun framing break cleared by reading LSR.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Parity, Overrun or Framing\nerrors or Break Interrupt\nReading the Line\nStatus Register",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "t_irq_id_cov_f_rda",
      "statement": "IIR 010 is 2nd priority Receiver Data Available when FIFO reaches trigger cleared when FIFO drops below trigger.",
      "source_id": "CH-f91cbf1c05",
      "quote": "FIFO trigger level reached FIFO drops below\ntrigger level",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "t_irq_id_cov_f_timeout",
      "statement": "IIR 110 is 2nd priority Timeout when data remains without input or read for 4 char times cleared by reading FIFO.",
      "source_id": "CH-f91cbf1c05",
      "quote": "There\u2019s at least 1 character\nin the FIFO but no character\nhas been input to the FIFO\nor read from it for the last 4\nChar times.\nReading from the\nFIFO (Receiver\nBuffer Register)",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "t_irq_id_cov_f_thre",
      "statement": "IIR 001 is 3rd priority Transmitter Holding Register Empty cleared by writing THR or reading IIR.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Transmitter Holding\nRegister Empty\nWriting to the\nTransmitter Holding\nRegister or reading\nIIR.",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "t_irq_id_cov_f_modem",
      "statement": "IIR 000 is 4th priority Modem Status from CTS DSR RI DCD cleared by reading MSR.",
      "source_id": "CH-f91cbf1c05",
      "quote": "0 0 0 4 th Modem Status CTS, DSR, RI or DCD. Reading the Modem\nstatus register.",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "t_irq_id_cov_f_fixed45",
