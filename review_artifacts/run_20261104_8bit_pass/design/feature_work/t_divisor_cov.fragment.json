  "facts": [
    {
      "id": "f_lsb_addr",
      "statement": "Divisor Latch LSB is 8-bit RW at bus address 0.",
      "source_id": "CH-f88915355b",
      "quote": "Divisor Latch Byte 1 (LSB) 0 8 RW The LSB of the divisor",
      "plan_pointer": "/registers/registers/0"
    },
    {
      "id": "f_msb_addr",
      "statement": "Divisor Latch MSB is 8-bit RW at bus address 1.",
      "source_id": "CH-f88915355b",
      "quote": "Divisor Latch Byte 2 1 8 RW The MSB of the divisor",
      "plan_pointer": "/registers/registers/3"
    },
    {
      "id": "f_dlab_gating",
      "statement": "Divisor registers accessible when LCR DLAB bit 7 is 1; normal registers at addresses 0-1 not accessible then.",
      "source_id": "CH-f88915355b",
      "quote": "The registers can be accessed when the 7th (DLAB) bit of the Line Control Register is set\nto \u20181\u2019. At this time the above registers at addresses 0-1 can\u2019t be accessed.",
      "plan_pointer": "/registers/registers/0"
    },
    {
      "id": "f_dlab_bit",
      "statement": "LCR bit 7 value 1 selects divisor latches, value 0 selects normal registers.",
      "source_id": "CH-bc7559f2ec",
      "quote": "\u20181\u2019 \u2013 The divisor latches can be accessed\n \u20180\u2019 \u2013 The normal registers are accessed",
      "plan_pointer": "/registers/registers/7/fields/6"
    },
    {
      "id": "f_div_single",
      "statement": "LSB and MSB form one 16-bit divisor accessed internally as single number.",
      "source_id": "CH-06bad6ffcd",
      "quote": "The 2 bytes form one 16-bit register, which is\ninternally accessed as a single number.",
      "plan_pointer": "/sections/1/entries/8"
    },
    {
      "id": "f_div_both",
      "statement": "Both divisor bytes must be set to ensure normal operation.",
      "source_id": "CH-06bad6ffcd",
      "quote": "You should therefore set all 2 bytes of the register\nto ensure normal operation.",
      "plan_pointer": "/sections/1/entries/8"
    },
    {
      "id": "f_div_order",
      "statement": "Program divisor MSB first LSB last; counter starts when LSB written.",
      "source_id": "CH-06bad6ffcd",
      "quote": "The internal counter starts to work when the LSB of DL is written, so when setting the\ndivisor, write the MSB first and the LSB last.",
      "plan_pointer": "/sections/1/entries/8"
    },
    {
      "id": "f_div_zero",
      "statement": "Divisor default 0 on reset disables serial I/O requiring explicit setup.",
      "source_id": "CH-06bad6ffcd",
      "quote": "The register is set to the default value of 0 on reset, which\ndisables all serial I/O operations in order to ensure explicit setup of the register in the\nsoftware.",
      "plan_pointer": "/sections/1/entries/8"
    },
    {
      "id": "f_dlab_restore",
      "statement": "Access divisor by setting LCR bit 7 to 1 and restore to 0 after to restore other registers.",
      "source_id": "CH-06bad6ffcd",
      "quote": "The divisor latches can be accessed by setting the 7th bit of LCR to \u20181\u2019. You should\nrestore this bit to \u20180\u2019 after setting the divisor latches in order to restore access to the other\nregisters that occupy the same addresses.",
      "plan_pointer": "/sections/1/entries/8"
    }
  ],
