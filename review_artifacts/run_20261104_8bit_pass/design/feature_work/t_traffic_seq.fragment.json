  "facts": [
    {
      "id": "f_ier_rda",
      "statement": "IER bit 0 enables Received Data available interrupt with 0 disabled and 1 enabled.",
      "source_id": "CH-de51b2eafc",
      "quote": "0 RW Received Data available interrupt\n \u20180\u2019 \u2013 disabled\n \u20181\u2019 \u2013 enabled",
      "plan_pointer": "/sections/8/entries/2"
    },
    {
      "id": "f_ier_thre",
      "statement": "IER bit 1 enables Transmitter Holding Register empty interrupt with 0 disabled and 1 enabled.",
      "source_id": "CH-de51b2eafc",
      "quote": "1 RW Transmitter Holding Register empty interrupt\n \u20180\u2019 \u2013 disabled\n \u20181\u2019 \u2013 enabled",
      "plan_pointer": "/sections/8/entries/2"
    },
    {
      "id": "f_ier_lsi",
      "statement": "IER bit 2 enables Receiver Line Status interrupt with 0 disabled and 1 enabled.",
      "source_id": "CH-de51b2eafc",
      "quote": "2 RW Receiver Line Status Interrupt\n \u20180\u2019 \u2013 disabled\n \u20181\u2019 \u2013 enabled",
      "plan_pointer": "/sections/8/entries/2"
    },
    {
      "id": "f_ier_msi",
      "statement": "IER bit 3 enables Modem Status interrupt with 0 disabled and 1 enabled.",
      "source_id": "CH-de51b2eafc",
      "quote": "3 RW Modem Status Interrupt\n \u20180\u2019 \u2013 disabled\n \u20181\u2019 \u2013 enabled",
      "plan_pointer": "/sections/8/entries/2"
    },
    {
      "id": "f_mcr_loopback",
      "statement": "MCR bit 4 selects normal versus loopback with STX_PAD_O set to 1 and transmitter shift internally connected to receiver shift in loopback.",
      "source_id": "CH-6abe65aeff",
      "quote": "4 W Loopback mode\n \u20180\u2019 \u2013 normal operation\n \u20181\u2019 \u2013 loopback mode. When in loopback mode, the Serial\nOutput Signal (STX_PAD_O) is set to logic \u20181\u2019. The signal of the\ntransmitter shift register is internally connected to the input of the\nreceiver shift register.",
      "plan_pointer": "/sections/4/strategy/agents/5"
    },
    {
      "id": "f_mcr_map",
      "statement": "In loopback DTR connects to DSR and RTS to CTS and Out1 to RI and Out2 to DCD.",
      "source_id": "CH-6abe65aeff",
      "quote": "The following connections are made:\nDTR \u00ce  DSR\nRTS \u00ce CTS\nOut1 \u00ce RI\nOut2 \u00ce DCD",
      "plan_pointer": "/sections/4/strategy/agents/5"
    },
    {
      "id": "f_mcr_dtr_rts",
      "statement": "MCR bits 0 and 1 control DTR and RTS levels with inverted polarity.",
      "source_id": "CH-6abe65aeff",
      "quote": "0 W Data Terminal Ready (DTR) signal control\n \u20180\u2019 \u2013 DTR is \u20181\u2019\n \u20181\u2019 \u2013 DTR is \u20180\u2019\n1 W Request To Send (RTS) signal control\n \u20180\u2019 \u2013 RTS is \u20181\u2019\n \u20181\u2019 \u2013 RTS is \u20180\u2019",
      "plan_pointer": "/sections/4/strategy/agents/5"
    },
    {
      "id": "f_lcr_dlab",
      "statement": "LCR bit 7 selects divisor latches when 1 and normal registers when 0.",
      "source_id": "CH-bc7559f2ec",
      "quote": "7 RW Divisor Latch Access bit.\n \u20181\u2019 \u2013 The divisor latches can be accessed\n \u20180\u2019 \u2013 The normal registers are accessed",
      "plan_pointer": "/sections/12/entries/5"
    }
  ],
