  "facts": [
    {
      "id": "f_modem_src_1",
      "statement": "Modem Status interrupt source is CTS DSR RI or DCD cleared by reading Modem Status Register",
      "source_id": "CH-f91cbf1c05",
      "quote": "0 0 0 4 th Modem Status CTS, DSR, RI or DCD. Reading the Modem\nstatus register.",
      "plan_pointer": "/sections/9/entries/7"
    },
    {
      "id": "f_iir_pending_1",
      "statement": "IIR bit0 0 means interrupt pending and 1 means no interrupt pending",
      "source_id": "CH-f91cbf1c05",
      "quote": "Bit 0 indicates that an interrupt is pending when it\u2019s logic \u20180\u2019. When it\u2019s \u20181\u2019 \u2013 no interrupt\nis pending.",
      "plan_pointer": "/sections/9/entries/2"
    },
    {
      "id": "f_iir_fixed_1",
      "statement": "IIR bits 4-5 are 0 and bits 6-7 are 1",
      "source_id": "CH-f91cbf1c05",
      "quote": "Bits 4 and 5: Logic \u20180\u2019.\nBits 6 and 7: Logic \u20181\u2019 for compatibility reason.",
      "plan_pointer": "/sections/9/entries/2"
    },
    {
      "id": "f_ier_addr_1",
      "statement": "Interrupt Enable register at address 1 enables or masks interrupts",
      "source_id": "CH-f88915355b",
      "quote": "Interrupt Enable 1 8 RW Enable/Mask interrupts\ngenerated by the UART",
      "plan_pointer": "/sections/9/entries/5"
    },
    {
      "id": "f_iir_addr_1",
      "statement": "Interrupt Identification register at address 2 gets interrupt information",
      "source_id": "CH-f88915355b",
      "quote": "Interrupt Identification 2 8 R Get interrupt information",
      "plan_pointer": "/sections/9/entries/5"
    },
    {
      "id": "f_msr_addr_1_2",
      "statement": "Modem Status register at address 6 reports modem status",
      "source_id": "CH-f88915355b",
      "quote": "Modem Status 6 8 R Modem Status",
      "plan_pointer": "/sections/9/entries/5"
    },
    {
      "id": "f_dlab_gate_1",
      "statement": "Divisor access when LCR bit7 DLAB is 1 blocks addresses 0-1 normal registers",
      "source_id": "CH-f88915355b",
      "quote": "The registers can be accessed when the 7th (DLAB) bit of the Line Control Register is set\nto \u20181\u2019. At this time the above registers at addresses 0-1 can\u2019t be accessed.",
      "plan_pointer": "/sections/9/entries/5"
    },
    {
      "id": "f_serial_link_1",
      "statement": "UART provides serial communication with modem or external device over serial cable RS232",
      "source_id": "CH-2baa4497c0",
      "quote": "The UART (Universal Asynchronous Receiver/Transmitter) core provides serial\ncommunication capabilities, which allow communication with modem or other external\ndevices, like another computer using a serial cable and RS232 protocol.",
      "plan_pointer": "/sections/4/strategy/overview/0"
    },
    {
      "id": "f_modem_pads_1",
      "statement": "Core uses 2 serial pads plus optionally six modem control signals",
      "source_id": "CH-d62a4ba2db",
      "quote": "It requires 2 pads in the chip (serial in and serial out) and, optionally, another six modem\ncontrol signals, which can otherwise be implemented using general purpose I/Os on the\nchip.",
      "plan_pointer": "/sections/4/strategy/agents/3"
    }
  ],
