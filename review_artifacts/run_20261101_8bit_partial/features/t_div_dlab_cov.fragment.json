  "facts": [
    {
      "id": "f_div_lsb_addr",
      "statement": "Divisor Latch LSB is 8-bit RW at WISHBONE address 0.",
      "source_id": "CH-f88915355b",
      "quote": "Divisor Latch Byte 1 (LSB) 0 8 RW The LSB of the divisor",
      "plan_pointer": "/registers/registers/0"
    },
    {
      "id": "f_div_msb_addr",
      "statement": "Divisor Latch MSB is 8-bit RW at WISHBONE address 1.",
      "source_id": "CH-f88915355b",
      "quote": "Divisor Latch Byte 2 1 8 RW The MSB of the divisor",
      "plan_pointer": "/registers/registers/3"
    },
    {
      "id": "f_dlab_gates_div",
      "statement": "Divisor latches are accessible when LCR bit 7 DLAB is 1.",
      "source_id": "CH-f88915355b",
      "quote": "The registers can be accessed when the 7th (DLAB) bit of the Line Control Register is set",
      "plan_pointer": "/registers/registers/0"
    },
    {
      "id": "f_dlab_blocks_norm",
      "statement": "Normal registers at addresses 0 to 1 are inaccessible while DLAB is 1.",
      "source_id": "CH-f88915355b",
      "quote": "At this time the above registers at addresses 0-1 can\u2019t be accessed.",
      "plan_pointer": "/registers/registers/3"
    },
    {
      "id": "f_dlab_one",
      "statement": "LCR bit 7 value 1 selects divisor latch access.",
      "source_id": "CH-bc7559f2ec",
      "quote": " \u20181\u2019 \u2013 The divisor latches can be accessed",
      "plan_pointer": "/registers/registers/7/fields/6"
    },
    {
      "id": "f_dlab_zero",
      "statement": "LCR bit 7 value 0 selects normal register access.",
      "source_id": "CH-bc7559f2ec",
      "quote": " \u20180\u2019 \u2013 The normal registers are accessed",
      "plan_pointer": "/registers/registers/7/fields/6"
    },
    {
      "id": "f_div_reset_zero",
      "statement": "Divisor Latch register is set to 0 upon reset.",
      "source_id": "CH-1e2324cfc3",
      "quote": "\u2022 The Divisor Latch register is set to 0.",
      "plan_pointer": "/sections/5/entries/11"
    },
    {
      "id": "f_prog_msb_first",
      "statement": "Proper divisor programming is MSB first LSB next.",
      "source_id": "CH-1e2324cfc3",
      "quote": "\u2022 Set the Divisor Latches, MSB first, LSB next.",
      "plan_pointer": "/sections/5/entries/11"
    },
    {
      "id": "f_prog_dlab_set",
      "statement": "Proper operation sets LCR bit 7 to 1 to allow divisor latch access.",
      "source_id": "CH-1e2324cfc3",
      "quote": "to allow access to the Divisor Latches.",
      "plan_pointer": "/sections/5/entries/11"
    },
    {
      "id": "f_prog_dlab_clear",
      "statement": "Proper operation clears LCR bit 7 to 0 to disable divisor latch access.",
      "source_id": "CH-1e2324cfc3",
      "quote": "\u2022 Set bit 7 of LCR to \u20180\u2019 to disable access to Divisor Latches.",
      "plan_pointer": "/sections/5/entries/11"
    },
    {
      "id": "f_lcr_reset_2",
      "statement": "LCR reset value is 00000011b with DLAB 0.",
      "source_id": "CH-bc7559f2ec",
      "quote": "Reset Value: 00000011b",
      "plan_pointer": "/registers/registers/7/fields/6"
    }
  ],
