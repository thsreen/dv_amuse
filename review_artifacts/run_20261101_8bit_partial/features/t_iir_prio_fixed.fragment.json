  "facts": [
    {
      "id": "f_iir_func",
      "statement": "IIR retrieves current highest priority pending interrupt.",
      "source_id": "CH-f91cbf1c05",
      "quote": "The IIR enables the programmer to retrieve what is the current highest priority pending",
      "plan_pointer": "/sections/8/entries/6"
    },
    {
      "id": "f_iir_addr",
      "statement": "IIR is address 2 width 8 access R for interrupt information.",
      "source_id": "CH-f88915355b",
      "quote": "Interrupt Identification 2 8 R Get interrupt information",
      "plan_pointer": "/registers/registers/6"
    },
    {
      "id": "f_iir_reset_4",
      "statement": "IIR reset value is C1h.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Reset Value: C1h",
      "plan_pointer": "/registers/registers/6"
    },
    {
      "id": "f_iir_b0_pend",
      "statement": "IIR bit0 is 0 when interrupt pending.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Bit 0 indicates that an interrupt is pending when it\u2019s logic \u20180\u2019.",
      "plan_pointer": "/registers/registers/6/fields/0"
    },
    {
      "id": "f_iir_b0_idle",
      "statement": "IIR bit0 is 1 when no interrupt pending.",
      "source_id": "CH-f91cbf1c05",
      "quote": "When it\u2019s \u20181\u2019 \u2013 no interrupt",
      "plan_pointer": "/registers/registers/6/fields/0"
    },
    {
      "id": "f_iir_011",
      "statement": "IIR code 011 is 1st priority Receiver Line Status.",
      "source_id": "CH-f91cbf1c05",
      "quote": "0 1 1 1 st Receiver Line",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_010",
      "statement": "IIR code 010 is 2nd priority Receiver Data available.",
      "source_id": "CH-f91cbf1c05",
      "quote": "0 1 0 2 nd Receiver Data",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_110",
      "statement": "IIR code 110 is 2nd priority Timeout indication.",
      "source_id": "CH-f91cbf1c05",
      "quote": "1 1 0 2 nd Timeout",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_001",
      "statement": "IIR code 001 is 3rd priority Transmitter Holding Register empty.",
      "source_id": "CH-f91cbf1c05",
      "quote": "0 0 1 3 rd Transmitter Holding",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_000",
      "statement": "IIR code 000 is 4th priority Modem Status for CTS DSR RI or DCD.",
      "source_id": "CH-f91cbf1c05",
      "quote": "0 0 0 4 th Modem Status CTS, DSR, RI or DCD.",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_fix67",
      "statement": "IIR bits 7-6 are logic 1 for compatibility.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Bits 6 and 7: Logic \u20181\u2019 for compatibility reason.",
      "plan_pointer": "/registers/registers/6/fields/3"
    },
    {
      "id": "f_iir_fix45",
      "statement": "IIR bits 5-4 are logic 0.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Bits 4 and 5: Logic \u20180\u2019.",
      "plan_pointer": "/registers/registers/6/fields/2"
    },
    {
      "id": "f_iir_rst_lsr",
      "statement": "Receiver Line Status reset is reading Line Status Register.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Reading the Line\nStatus Register",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_rst_rda",
      "statement": "Receiver Data available reset is FIFO drops below trigger level.",
      "source_id": "CH-f91cbf1c05",
      "quote": "FIFO drops below",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_rst_timeout",
      "statement": "Timeout reset is reading Receiver Buffer Register.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Reading from the\nFIFO (Receiver\nBuffer Register)",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_rst_thre",
      "statement": "THRE empty reset is writing THR or reading IIR.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Writing to the\nTransmitter Holding\nRegister or reading\nIIR.",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_iir_rst_msr",
      "statement": "Modem Status reset is reading Modem status register.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Reading the Modem\nstatus register.",
      "plan_pointer": "/registers/registers/6/fields/1"
    }
