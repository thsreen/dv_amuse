  "facts": [
    {
      "id": "f_pe_top",
      "statement": "LSR bit 2 reports 1 when top-of-FIFO character was received with parity error.",
      "source_id": "CH-a2dd758e55",
      "quote": "The character that is currently at the top of the FIFO\nhas been received with parity error.",
      "plan_pointer": "/sections/8/entries/10"
    },
    {
      "id": "f_pe_clear",
      "statement": "LSR parity error bit clears on LSR read and generates Receiver Line Status interrupt.",
      "source_id": "CH-a2dd758e55",
      "quote": "has been received with parity error. The bit is cleared upon reading\nfrom the register. Generates Receiver Line Status interrupt.",
      "plan_pointer": "/registers/registers/9/fields/2"
    },
    {
      "id": "f_pe_zero",
      "statement": "LSR bit 2 reports 0 when no parity error in current character.",
      "source_id": "CH-a2dd758e55",
      "quote": "No parity error in the current character",
      "plan_pointer": "/registers/registers/9/fields/2"
    },
    {
      "id": "f_fe_top",
      "statement": "LSR bit 3 reports 1 when top-of-FIFO character lacked valid stop bit.",
      "source_id": "CH-a2dd758e55",
      "quote": "The received character at the top of the FIFO did not\nhave a valid stop bit.",
      "plan_pointer": "/sections/8/entries/11"
    },
    {
      "id": "f_fe_clear",
      "statement": "LSR framing error bit clears on LSR read and generates Receiver Line Status interrupt.",
      "source_id": "CH-a2dd758e55",
      "quote": "did not\nhave a valid stop bit. Of course, generally, it might be that all the\nfollowing data is corrupt. The bit is cleared upon reading from the\nregister. Generates Receiver Line Status interrupt.",
      "plan_pointer": "/registers/registers/9/fields/3"
    },
    {
      "id": "f_fe_zero",
      "statement": "LSR bit 3 reports 0 when no framing error in current character.",
      "source_id": "CH-a2dd758e55",
      "quote": "No framing error in the current character",
      "plan_pointer": "/registers/registers/9/fields/3"
    },
    {
      "id": "f_rls_int",
      "statement": "Receiver Line Status interrupt source is parity overrun framing or break and resets by reading Line Status Register.",
      "source_id": "CH-f91cbf1c05",
      "quote": "Parity, Overrun or Framing\nerrors or Break Interrupt\nReading the Line\nStatus Register",
      "plan_pointer": "/registers/registers/6/fields/1"
    },
    {
      "id": "f_first_stop",
      "statement": "Receiver checks only first stop bit for framing validity.",
      "source_id": "CH-bc7559f2ec",
      "quote": "Note that the receiver always checks the first stop bit only.",
      "plan_pointer": "/registers/registers/7/fields/1"
    }
